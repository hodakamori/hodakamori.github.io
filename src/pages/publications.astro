---
import Base from '../layouts/Base.astro';
import PubItem from '../components/PubItem.astro';
import T from '../components/T.astro';
import { publications, typeLabels, type PubType } from '../data/publications';
import { profile } from '../data/profile';
import { isTodo } from '../lib/site';

const plural: Record<PubType, string> = {
  journal: 'Journal articles',
  conference: 'Conference papers',
  preprint: 'Preprints',
  manuscript: 'Manuscripts',
  talk: 'Talks',
};
const types = (Object.keys(typeLabels) as PubType[]).filter((t) => publications.some((p) => p.type === t));

// Group by year, newest first; placeholder years ("[20XX]") go last.
const groups = new Map<string, typeof publications>();
for (const p of publications) {
  const key = String(p.year);
  groups.set(key, [...(groups.get(key) ?? []), p]);
}
const years = [...groups.keys()].sort((a, b) => {
  if (isTodo(a) !== isTodo(b)) return isTodo(a) ? 1 : -1;
  return Number(b) - Number(a);
});
const scholar = profile.links.find((l) => l.icon === 'scholar');
const orcid = profile.links.find((l) => l.icon === 'orcid');
---

<Base title="Publications" description={`Publications and talks by ${profile.name}.`}>
  <h1 class="page-title">Publications</h1>
  <p class="page-lead">
    Journal articles, manuscripts and talks. Also on{' '}
    {scholar?.href ? <a href={scholar.href}>Google Scholar</a> : <span class="todo">Google Scholar</span>}{' '}and{' '}
    {orcid?.href ? <a href={orcid.href}>ORCID</a> : <span class="todo">ORCID</span>}.
  </p>

  <div class="filters" role="group" aria-label="Filter by type">
    <button type="button" data-filter="all" aria-pressed="true">All<span>{publications.length}</span></button>
    {
      types.map((t) => (
        <button type="button" data-filter={t} aria-pressed="false">
          {plural[t]}
          <span>{publications.filter((p) => p.type === t).length}</span>
        </button>
      ))
    }
  </div>

  {
    years.map((year) => (
      <div class="ygroup">
        <T v={year} class="y" />
        <div>
          {groups.get(year)!.map((p) => (
            <PubItem pub={p} />
          ))}
        </div>
      </div>
    ))
  }
</Base>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  buttons.forEach((button) => {
    button.addEventListener('click', () => {
      const filter = button.dataset.filter;
      buttons.forEach((b) => b.setAttribute('aria-pressed', String(b === button)));
      document.querySelectorAll<HTMLElement>('.ygroup').forEach((group) => {
        let shown = 0;
        group.querySelectorAll<HTMLElement>('.pub').forEach((pub) => {
          const match = filter === 'all' || pub.dataset.type === filter;
          pub.hidden = !match;
          if (match) shown++;
        });
        group.hidden = shown === 0;
      });
    });
  });
</script>
