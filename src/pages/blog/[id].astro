---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, withBase } from '../../lib/site';

export async function getStaticPaths() {
  const posts = await getPosts();
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}

const { post } = Astro.props;
const { Content } = await render(post);
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <a class="back" href={withBase('/blog/')}>← All posts</a>
    <time class="post-date" datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <h1 class="page-title">{post.data.title}</h1>
    <p class="page-lead">{post.data.description}</p>
    <div class="prose">
      <Content />
    </div>
  </article>
</Base>
