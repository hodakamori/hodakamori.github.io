---
import Base from '../../layouts/Base.astro';
import { formatDate, getPosts, withBase } from '../../lib/site';

const posts = await getPosts();
---

<Base title="Blog" description="Notes and articles.">
  <h1 class="page-title">Blog</h1>
  <p class="page-lead">Notes on molecular simulation, visualization and the software behind them.</p>
  {
    posts.length === 0 ? (
      <p class="page-lead">No posts yet.</p>
    ) : (
      <ul class="posts">
        {posts.map((post) => (
          <li>
            <a href={withBase(`/blog/${post.id}/`)}>
              <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
              <span class="title">{post.data.title}</span>
              <span class="desc">{post.data.description}</span>
            </a>
          </li>
        ))}
      </ul>
    )
  }
</Base>
