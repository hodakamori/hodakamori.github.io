---
import Icon from './Icon.astro';
import { business } from '../data/profile';
---

<div class="services">
  {
    business.services.map((s) => (
      <div class="svc">
        <div class="ic">
          <Icon name={s.icon} />
        </div>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </div>
    ))
  }
</div>
